      "interval": "1d",
      "targets": [
        {
          "expr": "max(increase(homeassistant_sensor_energy_kwh{entity=\"sensor.counter_gas_water_2_gas_verbrauch_kwh\"}[$__interval]))",
          "legendFormat": "Gas/Tag",
          "refId": "A",
          "interval": "1d"
        }
      ]
    },
    {
      "title": "Sonneneinstrahlung & Bewölkung",
      "description": "Sonneneinstrahlung (W/m2) vs. Bewoelkungsgrad",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
