{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Langzeit-Korrelation von Wetter, Energieverbrauch, Raumklima und Fahrzeugdaten",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Wetter & Energieverbrauch",
      "type": "row"
    },
    {
      "title": "Aussentemperatur vs. Stromverbrauch (EG+OG)",
      "description": "Daikin-Mittelwert Aussentemperatur vs. Gesamt-Stromverbrauch beider Zaehler",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": 3600000
          },
          "unit": "celsius",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Strom Gesamt" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "watt" },
              { "id": "decimals", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.fillOpacity", "value": 10 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Aussen" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "max"] }
      },
      "targets": [
        {
          "expr": "avg(homeassistant_sensor_temperature_celsius{entity=~\"sensor.(helena|klima_schlafzimmer|steffi|wohnzimmer)_outside_temperature\"})",
          "legendFormat": "Aussen",
          "refId": "A"
        },
        {
          "expr": "max(homeassistant_sensor_power_w{entity=\"sensor.stromverbrauch\"})",
          "legendFormat": "Strom Gesamt",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Aussentemperatur vs. Gasleistung",
      "description": "Gas-Brennerleistung (kW) steigt bei niedrigen Aussentemperaturen. Smooth-Line zeigt den Zusammenhang.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": 3600000
          },
          "unit": "celsius",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Gas Leistung" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "kwatt" },
              { "id": "decimals", "value": 1 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.fillOpacity", "value": 20 },
              { "id": "custom.lineWidth", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Aussen" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "max"] }
      },
      "targets": [
        {
          "expr": "avg(homeassistant_sensor_temperature_celsius{entity=~\"sensor.(helena|klima_schlafzimmer|steffi|wohnzimmer)_outside_temperature\"})",
          "legendFormat": "Aussen",
          "refId": "A"
        },
        {
          "expr": "avg_over_time(max(homeassistant_sensor_unit_kw{entity=\"sensor.counter_gas_water_2_gas_leistung_kw\"})[15m:])",
          "legendFormat": "Gas Leistung",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Tagesverbrauch Strom (EG+OG)",
      "description": "Taeglicher Stromverbrauch beider Zaehler summiert",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "kwatth",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "yellow" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum", "mean"] }
      },
      "interval": "1d",
      "targets": [
        {
          "expr": "sum(increase(homeassistant_sensor_energy_kwh{entity=~\"sensor.stromzahler_eg|sensor.stromzahler_og\"}[$__interval]))",
          "legendFormat": "Strom/Tag (EG+OG)",
          "refId": "A",
          "interval": "1d"
        }
      ]
    },
    {
      "title": "Tagesverbrauch Gas",
      "description": "Taeglicher Gasverbrauch in kWh",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
