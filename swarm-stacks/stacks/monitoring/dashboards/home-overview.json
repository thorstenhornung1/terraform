    {
      "id": 8,
      "type": "bargauge",
      "title": "Kapazitaet — wo laeuft es zuerst voll?",
      "description": "Der SSD-Verschleiss steht bewusst hier und nicht im Alarmkanal: Er bewegt sich um wenige Prozent im Monat, und ein taeglicher Alarm darueber traegt keine neue Information. NICHT enthalten: 'Storage Pool 1' der Synology steht bei 99,999 % — das ist der NORMALZUSTAND (vollstaendig an das Volume vergeben) und kein Alarm. Ebenso weggelassen: der Frigate-Aufnahmespeicher, weil er dieselbe Platte misst wie Synology Volume 1. pbs_used erscheint unter zwei Datastore-Namen mit identischen Werten — deshalb max(), nicht sum().",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100*(1-raidFreeSize{raidName=\"Volume 1\"}/raidTotalSize{raidName=\"Volume 1\"})",
          "legendFormat": "Synology Volume 1",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100*max(pbs_used)/max(pbs_size)",
          "legendFormat": "PBS Datastore",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(100*(1-node_filesystem_avail_bytes{mountpoint=\"/srv/data\"}/node_filesystem_size_bytes{mountpoint=\"/srv/data\"}))",
          "legendFormat": "/srv/data (voller Node)",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100*max(ceph_cluster_total_used_bytes)/max(ceph_cluster_total_bytes)",
          "legendFormat": "Ceph Cluster",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "max(100*(1-node_filesystem_avail_bytes{mountpoint=\"/mnt/cephfs\"}/node_filesystem_size_bytes{mountpoint=\"/mnt/cephfs\"}))",
          "legendFormat": "CephFS",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 - min(diskRemainLife{job=\"snmp-synology\"} >= 0)",
          "legendFormat": "SSD-Verschleiss (Cache)",
          "instant": true,
          "range": false,
          "refId": "F"
        }
      ],
