{
  "dashboard": {
    "uid": "rescue-tracker",
    "title": "Rescue Aircraft Tracker",
    "tags": ["rescue", "adsb", "victoriametrics"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "category", "label": "Kategorie", "type": "query", "multi": true, "includeAll": true, "allValue": ".*",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "definition": "label_values(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\"}, aircraft_category)",
          "query": { "query": "label_values(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\"}, aircraft_category)", "refId": "cat" },
          "current": { "text": ["All"], "value": ["$__all"] }, "refresh": 2, "sort": 1
        },
        {
          "name": "rtype", "label": "Rescue-Typ", "type": "query", "multi": true, "includeAll": true, "allValue": ".*",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "definition": "label_values(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\"}, rescue_type)",
          "query": { "query": "label_values(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\"}, rescue_type)", "refId": "rt" },
          "current": { "text": ["All"], "value": ["$__all"] }, "refresh": 2, "sort": 1
        }
      ]
    },
    "annotations": { "list": [] },
    "panels": [
      {
        "id": 1, "type": "stat", "title": "Rescue-Aircraft",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [ { "refId": "A", "expr": "count(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"})", "instant": true } ],
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" } }
      },
      {
        "id": 2, "type": "stat", "title": "Rescue-Tracks aktiv",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [ { "refId": "A", "expr": "count(last_over_time(aircraft_tracks_total_distance_km[5m]) and on(hex) last_over_time(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}[5m]))", "instant": true } ],
        "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }, "unit": "short", "noValue": "0" } }
      },
      {
        "id": 3, "type": "stat", "title": "Max. Track-Distanz",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [ { "refId": "A", "expr": "max(last_over_time(aircraft_tracks_total_distance_km[5m]) and on(hex) last_over_time(rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}[5m]))", "instant": true } ],
        "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "lengthkm", "decimals": 1, "noValue": "—" } }
      },
      {
        "id": 4, "type": "piechart", "title": "Nach Rescue-Typ",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [ { "refId": "A", "expr": "count by (rescue_type) (rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"})", "instant": true, "legendFormat": "{{rescue_type}}" } ],
        "options": { "pieType": "donut", "legend": { "displayMode": "list", "placement": "right", "values": ["value"] }, "reduceOptions": { "calcs": ["lastNotNull"] } }
      },
      {
        "id": 5, "type": "geomap", "title": "Positionen (Marker = Heading, Label = Callsign, Tooltip = Details)",
        "gridPos": { "h": 14, "w": 16, "x": 0, "y": 4 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [
          { "refId": "LAT", "expr": "rescue_aircraft_latitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" },
          { "refId": "LON", "expr": "rescue_aircraft_longitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" },
          { "refId": "HDG", "expr": "rescue_aircraft_track{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" },
          { "refId": "ALT", "expr": "rescue_aircraft_altitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" }
        ],
        "transformations": [ { "id": "joinByField", "options": { "byField": "hex", "mode": "outer" } } ],
        "options": {
          "view": { "id": "coords", "lat": 50.8, "lon": 9.0, "zoom": 6 },
          "basemap": { "type": "osm-standard", "name": "OpenStreetMap" },
          "layers": [
            {
              "type": "markers", "name": "Rescue Aircraft",
              "location": { "mode": "coords", "latitude": "Value #LAT", "longitude": "Value #LON" },
              "config": {
                "style": {
                  "size": { "fixed": 10 },
                  "color": { "fixed": "dark-red" },
                  "symbol": { "fixed": "img/icons/marker/plane.svg", "mode": "fixed" },
                  "rotation": { "field": "Value #HDG", "fixed": 0, "max": 360, "min": -360, "mode": "field" },
                  "opacity": 1,
                  "textConfig": { "fontSize": 11, "offsetX": 0, "offsetY": -14, "textAlign": "center", "textBaseline": "middle" },
                  "text": { "field": "flight", "fixed": "" }
                },
                "showLegend": false
              },
              "tooltip": true
            }
          ],
          "controls": { "showZoom": true, "showAttribution": true, "mouseWheelZoom": true, "showDebug": false }
        },
        "fieldConfig": { "defaults": {}, "overrides": [] }
      },
      {
        "id": 6, "type": "bargauge", "title": "Höhe pro Aircraft (ft)",
        "gridPos": { "h": 14, "w": 8, "x": 16, "y": 4 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [ { "refId": "A", "expr": "rescue_aircraft_altitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"} > 0", "instant": true, "legendFormat": "{{flight}} ({{rescue_type}})" } ],
        "options": { "orientation": "horizontal", "displayMode": "gradient", "valueMode": "color", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" } },
        "fieldConfig": { "defaults": { "unit": "lengthft", "color": { "mode": "continuous-BlYlRd" }, "min": 0, "max": 45000 } }
      },
      {
        "id": 7, "type": "table", "title": "Aktive Rescue-Aircraft",
        "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "targets": [
          { "refId": "ALT", "expr": "rescue_aircraft_altitude{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" },
          { "refId": "GS", "expr": "rescue_aircraft_ground_speed{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" },
          { "refId": "HDG", "expr": "rescue_aircraft_track{rescue_type!=\"sar_mode_a\", aircraft_category=~\"$category\", rescue_type=~\"$rtype\"}", "instant": true, "format": "table" }
        ],
        "transformations": [
          { "id": "joinByField", "options": { "byField": "hex", "mode": "outer" } },
          { "id": "organize", "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true, "__name__ 1": true, "__name__ 2": true, "__name__ 3": true, "job": true, "instance": true, "location": true, "api_source 2": true, "api_source 3": true, "aircraft_type 2": true, "aircraft_type 3": true, "flight 2": true, "flight 3": true, "squawk 2": true, "squawk 3": true, "rescue_type 2": true, "rescue_type 3": true, "aircraft_category 2": true, "aircraft_category 3": true },
            "indexByName": { "flight 1": 0, "hex": 1, "rescue_type 1": 2, "aircraft_category 1": 3, "aircraft_type 1": 4, "squawk 1": 5, "Value #ALT": 6, "Value #GS": 7, "Value #HDG": 8, "api_source 1": 9 },
            "renameByName": { "Value #ALT": "Höhe (ft)", "Value #GS": "Speed (kt)", "Value #HDG": "Heading (°)", "flight 1": "Flug", "hex": "ICAO", "rescue_type 1": "Rescue-Typ", "aircraft_category 1": "Kategorie", "aircraft_type 1": "Typ", "squawk 1": "Squawk", "api_source 1": "Quelle" }
          } }
        ],
        "fieldConfig": { "defaults": { "custom": { "align": "auto", "filterable": true } } },
        "options": { "sortBy": [ { "displayName": "Höhe (ft)", "desc": true } ], "footer": { "show": false } }
      }
    ]
  },
  "overwrite": true,
  "message": "v3: visible markers (dark-red+heading+callsign), altitude moved to bargauge panel, allValue regex fix"
}
