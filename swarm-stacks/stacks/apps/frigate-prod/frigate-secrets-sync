#!/bin/bash
# =============================================================================
# Frigate Secrets Sync — Vaultwarden -> /etc/frigate/secrets.env
# =============================================================================
# Pulls secrets from a Vaultwarden collection and writes them as KEY=VALUE
# pairs to a local env file. Atomic write ensures Frigate always has a
# consistent secrets file, even if the sync fails mid-way.
#
# API credentials: /etc/frigate/bw-api.env (written by init-frigate-lxc.sh)
# Output:          /etc/frigate/secrets.env (0600 root:root)
#
# Fail-safe: On any error, the existing secrets.env is NOT modified.
#            Frigate survives reboots even when Vaultwarden is unreachable.
#
# Item convention in Vaultwarden:
#   - Collection name: "frigate"
#   - Item name = ENV variable name (e.g. FRIGATE_MQTT_USER)
#   - Login password field = secret value
# =============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
SECRETS_DIR="/etc/frigate"
SECRETS_FILE="$SECRETS_DIR/secrets.env"
SECRETS_TMP="$SECRETS_DIR/secrets.env.tmp"
API_ENV="$SECRETS_DIR/bw-api.env"
BW="/usr/local/bin/bw"
COLLECTION_NAME="frigate"
VAULTWARDEN_URL="https://vault.hornung-bn.de"

# ---------------------------------------------------------------------------
# Logging (metadata only, never secrets in cleartext)
# ---------------------------------------------------------------------------
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [frigate-secrets-sync] $*"; }
log_err() { echo "$(date '+%Y-%m-%d %H:%M:%S') [frigate-secrets-sync] ERROR: $*" >&2; }

# ---------------------------------------------------------------------------
# Cleanup on exit (always logout)
# ---------------------------------------------------------------------------
cleanup() {
  if [ -n "${BW_SESSION:-}" ]; then
    $BW logout --quiet 2>/dev/null || true
  fi
  rm -f "$SECRETS_TMP"
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# Validate prerequisites
# ---------------------------------------------------------------------------
if [ ! -x "$BW" ]; then
  log_err "bw CLI not found at $BW"
  exit 1
fi

if [ ! -f "$API_ENV" ]; then
  log_err "API credentials not found at $API_ENV — run init-frigate-lxc.sh first"
  exit 1
fi

# Load API credentials
# shellcheck source=/dev/null
. "$API_ENV"

for var in BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD; do
  if [ -z "${!var:-}" ]; then
    log_err "Missing $var in $API_ENV"
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# Authenticate with Vaultwarden
# ---------------------------------------------------------------------------
log "Configuring Vaultwarden server..."
$BW config server "$VAULTWARDEN_URL" --quiet

log "Logging in with API key..."
export BW_CLIENTID BW_CLIENTSECRET
$BW login --apikey --quiet 2>/dev/null

log "Unlocking vault..."
export BW_SESSION
BW_SESSION=$($BW unlock --passwordenv BW_PASSWORD --raw)

log "Syncing vault..."
$BW sync --session "$BW_SESSION" --quiet

# ---------------------------------------------------------------------------
# Find the "frigate" collection
# ---------------------------------------------------------------------------
log "Looking up collection '$COLLECTION_NAME'..."
COLLECTION_ID=$($BW list collections --session "$BW_SESSION" | \
  jq -r --arg name "$COLLECTION_NAME" '.[] | select(.name == $name) | .id')

if [ -z "$COLLECTION_ID" ]; then
  log_err "Collection '$COLLECTION_NAME' not found in Vaultwarden"
  exit 1
fi

log "Collection ID: $COLLECTION_ID"

# ---------------------------------------------------------------------------
# Extract secrets from collection items
# ---------------------------------------------------------------------------
log "Reading items from collection..."

# Get all login items in the collection, extract name (=key) and password (=value)
ITEMS_JSON=$($BW list items --collectionid "$COLLECTION_ID" --session "$BW_SESSION")

# Write to temp file atomically
echo "# Frigate secrets — synced from Vaultwarden $(date '+%Y-%m-%d %H:%M:%S')" > "$SECRETS_TMP"
echo "# Collection: $COLLECTION_NAME ($COLLECTION_ID)" >> "$SECRETS_TMP"
echo "# DO NOT EDIT — managed by frigate-secrets-sync" >> "$SECRETS_TMP"
echo "" >> "$SECRETS_TMP"

KEY_COUNT=0
while IFS=$'\t' read -r name password; do
  # Skip items without a password
  if [ -z "$password" ] || [ "$password" = "null" ]; then
    log "SKIP: $name (no password field)"
    continue
  fi
  echo "${name}=${password}" >> "$SECRETS_TMP"
  KEY_COUNT=$((KEY_COUNT + 1))
done < <(echo "$ITEMS_JSON" | jq -r '.[] | select(.login != null) | [.name, .login.password] | @tsv')

# ---------------------------------------------------------------------------
# Validate and atomically replace
# ---------------------------------------------------------------------------
if [ "$KEY_COUNT" -eq 0 ]; then
  log_err "No secrets found in collection '$COLLECTION_NAME' — refusing to write empty file"
  exit 1
fi

chmod 600 "$SECRETS_TMP"
mv "$SECRETS_TMP" "$SECRETS_FILE"

log "SUCCESS: Synced $KEY_COUNT keys to $SECRETS_FILE"
