[Unit]
Description=Daily Frigate secrets sync from Vaultwarden

[Timer]
# Run daily at 03:00 (after PBS backup at 02:00)
OnCalendar=*-*-* 03:00:00
# Add up to 30 min randomized delay to avoid thundering herd
RandomizedDelaySec=1800
# Run immediately if last scheduled run was missed (e.g. reboot)
Persistent=true

[Install]
WantedBy=timers.target
